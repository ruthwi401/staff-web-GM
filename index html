 $("ordersBody").innerHTML=list.length?list.map(o=>`<tr>
 <td><div class="t-strong">${esc(o.id)}</div><div class="t-muted">${esc(o.time)}</div></td>
 <td><div class="t-strong">${esc(o.customer)}</div><div class="t-muted">${esc(o.phone)}</div></td>
 <td>${itemCount(o)} items<div class="t-muted">${esc(o.items.map(i=>i.name+" × "+i.qty).join(", "))}</div></td>
 <td><strong>${money(o.total)}</strong></td><td>${statusBadge(o.status)}</td><td><div class="table-actions">${actions(o)}${o.status!=="Delivered"&&o.status!=="Cancelled"?`<button class="btn btn-small btn-danger" data-cancel="${esc(o.id)}">Cancel</button>`:""}</div></td>
 </tr>`).join(""):`<tr><td colspan="6"><div class="empty"><div class="empty-icon">🔎</div><strong>No matching orders</strong>Try another search or filter.</div></td></tr>`;
}
function stockStatus(p){return p.stock===0?"Out of stock":p.stock<=p.min?"Low stock":"In stock"}
function stockClass(p){return p.stock===0?"cancelled":p.stock<=p.min?"pending":"ready"}
function renderInventory(){
 const q=($("inventorySearch")?.value||"").toLowerCase(),filter=$("inventoryFilter")?.value||"all";
 const list=products.filter(p=>{
  const match=(p.name+" "+p.category).toLowerCase().includes(q);
  const f=filter==="all"||(filter==="low"&&p.stock>0&&p.stock<=p.min)||(filter==="out"&&p.stock===0)||(filter==="available"&&p.stock>p.min);
  return match&&f;
 });
 $("inventoryStats").innerHTML=[["Products",products.length],["Low stock",products.filter(p=>p.stock>0&&p.stock<=p.min).length],["Out of stock",products.filter(p=>p.stock===0).length]].map(x=>`<div class="mini-stat"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join("");
 $("inventoryBody").innerHTML=list.length?list.map(p=>`<tr>
 <td><div style="display:flex;align-items:center;gap:9px"><div class="product-icon" style="height:35px;width:35px;font-size:19px">${esc(p.emoji)}</div><div><div class="t-strong">${esc(p.name)}</div><div class="t-muted">SKU-${String(p.id).padStart(4,"0")}</div></div></div></td>
 <td>${esc(p.category)}</td><td><strong>${money(p.price)}</strong></td>
 <td><div class="inventory-qty"><button class="qty-btn" data-stock="${p.id}" data-delta="-1" aria-label="Decrease stock">−</button><span class="qty-number">${p.stock}</span><button class="qty-btn" data-stock="${p.id}" data-delta="1" aria-label="Increase stock">+</button></div><div class="t-muted">Minimum ${p.min}</div></td>
 <td>${statusBadge(stockStatus(p))}</td><td><div class="table-actions"><button class="btn btn-small" data-edit="${p.id}">Edit</button><button class="btn btn-small btn-danger" data-delete="${p.id}">Delete</button></div></td>
 </tr>`).join(""):`<tr><td colspan="6"><div class="empty"><div class="empty-icon">📦</div><strong>No matching products</strong>Try a different filter or add a product.</div></td></tr>`;
}
function renderTasks(){
 const todo=tasks.filter(t=>!t.done),done=tasks.filter(t=>t.done);
 $("taskStats").innerHTML=[["All tasks",tasks.length],["Remaining",todo.length],["Completed",done.length]].map(x=>`<div class="mini-stat"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join("");
 $("todoBadge").textContent=todo.length+" tasks";$("doneBadge").textContent=done.length+" tasks";
 const makeRows=list=>list.length?list.map(t=>`<div class="task-row ${t.done?"completed":""}"><input class="task-check" type="checkbox" data-task-check="${t.id}" ${t.done?"checked":""}><div class="task-main"><strong>${esc(t.title)}</strong><p>${esc(t.detail)}</p><span class="badge">${esc(t.category)}</span></div><button class="btn btn-small btn-danger" data-task-delete="${t.id}" aria-label="Delete task">×</button></div>`).join(""):`<div class="empty"><div class="empty-icon">${list===todo?"🎉":"📝"}</div><strong>${list===todo?"Nothing left to do":"No completed tasks yet"}</strong></div>`;
 $("todoTasks").innerHTML=makeRows(todo);$("doneTasks").innerHTML=makeRows(done);
}
function renderReports(){
 const delivered=orders.filter(o=>o.status==="Delivered");
 $("reportOrders").textContent=orders.length;
 $("reportRevenue").textContent=money(delivered.reduce((n,o)=>n+o.total,0));
 $("reportStock").textContent=products.reduce((n,p)=>n+p.stock,0);
 $("reportTasks").textContent=tasks.filter(t=>!t.done).length;
 const colors={"Pending":"#d89a38","Preparing":"#5d8ad3","Packed":"#9676c7","Ready for delivery":"#409765","Delivered":"#a0b1a3","Cancelled":"#db7777"};
 $("reportBreakdown").innerHTML=STATUSES.map(s=>{
  const count=orders.filter(o=>o.status===s).length,pc=orders.length?count/orders.length*100:0;
  return `<div class="report-row"><div class="report-label"><span>${esc(s)}</span><span>${count} orders</span></div><div class="bar-track"><div class="bar-fill" style="width:${pc}%;background:${colors[s]}"></div></div></div>`;
 }).join("");
 const groups=[{label:"Healthy stock",count:products.filter(p=>p.stock>p.min).length,color:"#409765"},{label:"Low stock",count:products.filter(p=>p.stock>0&&p.stock<=p.min).length,color:"#d89a38"},{label:"Out of stock",count:products.filter(p=>p.stock===0).length,color:"#db7777"}];
 $("inventoryBreakdown").innerHTML=groups.map(g=>`<div class="report-row"><div class="report-label"><span>${g.label}</span><span>${g.count} products</span></div><div class="bar-track"><div class="bar-fill" style="width:${products.length?g.count/products.length*100:0}%;background:${g.color}"></div></div></div>`).join("");
}
function render(){renderStats();renderRecent();renderStockWatch();renderDashTasks();renderActivity();renderOrders();renderInventory();renderTasks();renderReports()}
function openModal(title,body,mode,submitLabel="Save"){
 modalMode=mode;$("modalTitle").textContent=title;$("modalBody").innerHTML=body;$("modalSubmit").textContent=submitLabel;$("modalBackdrop").classList.add("open");
 setTimeout(()=>{const el=$("modalBody").querySelector("input,select,textarea");if(el)el.focus()},25);
}
function closeModal(){$("modalBackdrop").classList.remove("open");modalMode=null}
function formField(label,name,value="",type="text",opts=""){
 return `<div class="form-field"><label for="f_${name}">${label}</label>${type==="select"?`<select id="f_${name}" name="${name}" required>${opts}</select>`:`<input id="f_${name}" name="${name}" type="${type}" value="${esc(value)}" required ${type==="number"?'min="0" step="any"':""}>`}</div>`;
}
const categories=["Vegetables","Fruits","Dairy","Bakery","Staples","Beverages","Household","Other"];
function categoryOptions(current=""){return categories.map(c=>`<option ${c===current?"selected":""}>${c}</option>`).join("")}
function addProduct(){
 openModal("Add inventory product",`<div class="form-grid">
 <div class="form-field full"><label for="f_name">Product name</label><input id="f_name" name="name" required placeholder="Enter product name"></div>
 ${formField("Category","category","","select",categoryOptions())}
 ${formField("Price (₹)","price",0,"number")}
 ${formField("Stock quantity","stock",0,"number")}
 ${formField("Minimum stock level","min",5,"number")}
 ${formField("Emoji icon","emoji","🛒")}
 </div>`,"addProduct");
}
function editProduct(id){
 const p=products.find(x=>x.id===id);if(!p)return;
 openModal("Edit product",`<div class="form-grid">
 <div class="form-field full"><label for="f_name">Product name</label><input id="f_name" name="name" required value="${esc(p.name)}"></div>
 ${formField("Category","category",p.category,"select",categoryOptions(p.category))}
 ${formField("Price (₹)","price",p.price,"number")}
 ${formField("Stock quantity","stock",p.stock,"number")}
 ${formField("Minimum stock level","min",p.min,"number")}
 ${formField("Emoji icon","emoji",p.emoji)}
 </div>`,"editProduct:"+id);
}
function addTask(){
 openModal("Create staff task",`<div class="form-grid">
 <div class="form-field full"><label for="f_title">Task title</label><input id="f_title" name="title" required placeholder="e.g. Check freezer temperatures"></div>
 <div class="form-field full"><label for="f_detail">Task description</label><textarea id="f_detail" name="detail" rows="3" placeholder="Add useful instructions"></textarea></div>
 ${formField("Department","category","","select",["Orders","Inventory","Fresh produce","Store upkeep","Customer service","Other"].map(c=>`<option>${c}</option>`).join(""))}
 </div>`,"addTask","Create task");
}
function orderDetails(id){
 const o=orders.find(x=>x.id===id);if(!o)return;
 openModal("Order details · "+o.id,`
 <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:18px">${statusBadge(o.status)}<strong style="font-size:14px">${money(o.total)}</strong></div>
 <div style="font-size:11px;line-height:2"><strong>Customer:</strong> ${esc(o.customer)}<br><strong>Contact:</strong> ${esc(o.phone)}<br><strong>Delivery address:</strong> ${esc(o.address)}<br><strong>Order time:</strong> ${esc(o.time)}</div>
 <h3 style="font-size:12px;margin:20px 0 8px">Items</h3>
 ${o.items.map(i=>`<div style="display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid var(--line);font-size:11px"><span>${esc(i.name)}</span><strong>× ${i.qty}</strong></div>`).join("")}
 <p style="font-size:10px;color:var(--muted);line-height:1.7;margin:16px 0 0">Sample order details only. This demo does not contact customers or dispatch delivery partners.</p>`,"orderDetail:"+id,"Close");
}
$("modalForm").addEventListener("submit",e=>{
 e.preventDefault();if(!modalMode)return;
 const d=Object.fromEntries(new FormData(e.currentTarget).entries());
 if(modalMode==="addProduct"){
  if(!d.name.trim())return;
  products.push({id:Math.max(0,...products.map(p=>p.id))+1,name:d.name.trim(),category:d.category,price:Number(d.price),stock:Number(d.stock),min:Number(d.min),emoji:d.emoji.trim()||"🛒"});
  log("📦","Added product: "+d.name.trim());save();closeModal();render();notify("Product added successfully.");
 }else if(modalMode.startsWith("editProduct:")){
  const p=products.find(x=>x.id===Number(modalMode.split(":")[1]));
  if(p){p.name=d.name.trim();p.category=d.category;p.price=Number(d.price);p.stock=Number(d.stock);p.min=Number(d.min);p.emoji=d.emoji.trim()||"🛒";log("📦","Updated product: "+p.name);}
  save();closeModal();render();notify("Product updated.");
 }else if(modalMode==="addTask"){
  tasks.unshift({id:Math.max(0,...tasks.map(t=>t.id))+1,title:d.title.trim(),detail:d.detail.trim()||"No additional details",category:d.category,done:false});
  log("☑️","Created task: "+d.title.trim());save();closeModal();render();notify("Staff task created.");
 }else closeModal();
});
function updateOrder(id,status){
 const o=orders.find(x=>x.id===id);if(!o)return;
 o.status=status;log("🛍️",o.id+" changed to "+status);save();render();notify(o.id+" updated: "+status+".");
}
function csvDownload(filename,rows){
 const content=rows.map(row=>row.map(v=>'"'+String(v??"").replace(/"/g,'""')+'"').join(",")).join("\r\n");
 const blob=new Blob(["\ufeff"+content],{type:"text/csv;charset=utf-8"});
 const url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);
}
function exportOrders(){
 csvDownload("green-mart-demo-orders.csv",[["Order ID","Customer","Items","Total INR","Status","Time"],...orders.map(o=>[o.id,o.customer,o.items.map(i=>i.name+" x"+i.qty).join("; "),o.total,o.status,o.time])]);
 notify("Order CSV downloaded.");
}
function exportReport(){
 csvDownload("green-mart-demo-report.csv",[["Metric","Value"],["Demo orders",orders.length],["Delivered order value INR",orders.filter(o=>o.status==="Delivered").reduce((n,o)=>n+o.total,0)],["Inventory units",products.reduce((n,p)=>n+p.stock,0)],["Low stock products",products.filter(p=>p.stock<=p.min).length],["Outstanding tasks",tasks.filter(t=>!t.done).length],[],["Product","Category","Price INR","Stock","Minimum stock"],...products.map(p=>[p.name,p.category,p.price,p.stock,p.min])]);
 notify("Demo report downloaded.");
}
document.addEventListener("click",e=>{
 const nav=e.target.closest("[data-page]");if(nav){setPage(nav.dataset.page);return}
 const go=e.target.closest("[data-goto]");if(go){setPage(go.dataset.goto);return}
 const advance=e.target.closest("[data-next]");
 if(advance){const o=orders.find(x=>x.id===advance.dataset.next);if(o)updateOrder(o.id,nextStatus(o.status));return}
 const detail=e.target.closest("[data-detail]");
 if(detail){orderDetails(detail.dataset.detail);return}
 const cancel=e.target.closest("[data-cancel]");
 if(cancel){const o=orders.find(x=>x.id===cancel.dataset.cancel);if(o&&confirm("Cancel demo order "+o.id+"?"))updateOrder(o.id,"Cancelled");return}
 const stock=e.target.closest("[data-stock]");
 if(stock){
  const p=products.find(x=>x.id===Number(stock.dataset.stock));if(!p)return;
  p.stock=Math.max(0,p.stock+Number(stock.dataset.delta));log("📦","Stock updated for "+p.name+": "+p.stock+" units");save();render();notify(p.name+" stock: "+p.stock);return;
 }
 const edit=e.target.closest("[data-edit]");if(edit){editProduct(Number(edit.dataset.edit));return}
 const del=e.target.closest("[data-delete]");
 if(del){
  const p=products.find(x=>x.id===Number(del.dataset.delete));if(p&&confirm("Delete "+p.name+" from the demo inventory?")){
   products=products.filter(x=>x.id!==p.id);log("📦","Removed product: "+p.name);save();render();notify("Product removed.");
  }return;
 }
 const taskDel=e.target.closest("[data-task-delete]");
 if(taskDel){
  const t=tasks.find(x=>x.id===Number(taskDel.dataset.taskDelete));
  if(t&&confirm("Delete task: "+t.title+"?")){tasks=tasks.filter(x=>x.id!==t.id);log("☑️","Deleted task: "+t.title);save();render();notify("Task deleted.");}
 }
});
document.addEventListener("change",e=>{
 if(e.target.matches("[data-task-check]")){
  const t=tasks.find(x=>x.id===Number(e.target.dataset.taskCheck));if(!t)return;
  t.done=e.target.checked;log("☑️",(t.done?"Completed task: ":"Reopened task: ")+t.title);save();render();notify(t.done?"Task completed.":"Task reopened.");
 }
});
$("menuToggle").addEventListener("click",()=>$("sidebar").classList.toggle("open"));
$("modalClose").addEventListener("click",closeModal);
$("modalCancel").addEventListener("click",closeModal);
$("modalBackdrop").addEventListener("click",e=>{if(e.target===$("modalBackdrop"))closeModal()});
document.addEventListener("keydown",e=>{if(e.key==="Escape")closeModal()});
$("addProductBtn").addEventListener("click",addProduct);
$("addTaskBtn").addEventListener("click",addTask);
$("exportOrders").addEventListener("click",exportOrders);
$("exportReport").addEventListener("click",exportReport);
$("orderSearch").addEventListener("input",renderOrders);
$("orderFilter").addEventListener("change",renderOrders);
$("inventorySearch").addEventListener("input",renderInventory);
$("inventoryFilter").addEventListener("change",renderInventory);
$("globalSearch").addEventListener("keydown",e=>{
 if(e.key!=="Enter")return;
 const q=e.target.value.trim();if(!q)return;
 const foundOrder=orders.some(o=>(o.id+" "+o.customer).toLowerCase().includes(q.toLowerCase()));
 setPage(foundOrder?"orders":"inventory");
 if(foundOrder){$("orderSearch").value=q;renderOrders()}else{$("inventorySearch").value=q;renderInventory()}
});
$("alertsBtn").addEventListener("click",()=>{
 const pending=orders.filter(o=>o.status==="Pending").length,low=products.filter(p=>p.stock<=p.min).length;
 notify(pending+" pending orders · "+low+" products at or below minimum stock.");
});
$("year").textContent=new Date().getFullYear();
$("dateValue").textContent=new Date().toLocaleDateString("en-IN",{weekday:"short",day:"numeric",month:"short",year:"numeric"});
render();
})();
</script>
</body>
</html>
