
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#123c2b">
<title>Green Mart V4 — Operations Centre</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
 --forest:#123c2b;--forest2:#1c5a3e;--green:#238653;--mint:#e7f5eb;
 --bg:#f5f7f4;--white:#fff;--ink:#18271e;--muted:#7d8980;
 --line:#e7ece7;--orange:#b8781d;--orangebg:#fff4df;
 --blue:#4776c7;--bluebg:#edf3ff;--red:#c94e4e;--redbg:#ffeded;
 --purple:#8661ba;--purplebg:#f2edfb;--shadow:0 8px 30px rgba(25,55,37,.045);
 --radius:17px;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:14px "DM Sans",sans-serif}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #a6d8b5;outline-offset:2px}
button:disabled{opacity:.5;cursor:not-allowed}
.sidebar{position:fixed;inset:0 auto 0 0;width:254px;background:var(--forest);color:#fff;padding:25px 17px;display:flex;flex-direction:column;z-index:50;transition:transform .25s}
.brand{display:flex;align-items:center;gap:11px;padding:0 8px 27px}
.brand-icon{width:43px;height:43px;border-radius:14px;background:#dff4e5;color:var(--forest);display:grid;place-items:center;font-size:24px}
.brand-title{font:800 17px Manrope,sans-serif;letter-spacing:-.5px}
.brand-sub{font-size:10px;color:#b6d5c1;letter-spacing:1.4px;margin-top:4px}
.nav-caption{font-size:10px;letter-spacing:1.7px;color:#86ad94;font-weight:700;padding:15px 12px 9px}
.nav{display:grid;gap:5px}
.nav button{border:0;background:transparent;color:#c5d9cb;border-radius:11px;padding:12px;display:flex;align-items:center;gap:12px;text-align:left;width:100%;font-size:12px;font-weight:600;transition:.18s}
.nav button:hover{background:#ffffff10;color:white}
.nav button.active{background:#ffffff17;color:white;box-shadow:inset 3px 0 #8fe0a8}
.nav-icon{font-size:17px;width:21px;text-align:center}
.nav-badge{margin-left:auto;border-radius:7px;background:#ffffff19;padding:4px 7px;font-size:10px}
.sidebar-bottom{margin-top:auto}
.connection-card{padding:14px;border-radius:13px;background:#ffffff0c;border:1px solid #ffffff18}
.connection-title{font-size:11px;font-weight:700}
.connection-desc{font-size:10px;line-height:1.6;color:#bad0c1;margin-top:6px}
.connection-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#86e3a1;margin-right:6px}
.main{margin-left:254px;min-height:100vh}
.topbar{height:75px;background:#ffffffed;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 32px;gap:16px;position:sticky;top:0;z-index:30;backdrop-filter:blur(16px)}
.top-left{display:flex;align-items:center;gap:12px;min-width:0}
.breadcrumb{font-size:10px;color:var(--muted);margin-bottom:4px}
.top-title{font:800 17px Manrope,sans-serif;letter-spacing:-.4px}
.top-right{display:flex;align-items:center;gap:11px}
.search{position:relative}
.search input{width:225px;border:1px solid var(--line);background:#f8faf7;border-radius:10px;padding:10px 12px 10px 34px;font-size:11px}
.search-icon{position:absolute;left:12px;top:9px;color:var(--muted);font-size:16px}
.icon-btn{width:37px;height:37px;border:1px solid var(--line);background:white;border-radius:10px;display:grid;place-items:center;color:#536157;font-size:16px;position:relative}
.icon-btn:hover{background:var(--mint)}
.alert-dot{position:absolute;right:7px;top:7px;background:#e86c57;border:2px solid white;width:8px;height:8px;border-radius:50%}
.profile{display:flex;align-items:center;gap:9px;border-left:1px solid var(--line);padding-left:14px}
.avatar{height:36px;width:36px;border-radius:12px;background:#e1f1e5;color:var(--forest);font-size:11px;font-weight:800;display:grid;place-items:center}
.profile-name{font-size:11px;font-weight:800}
.profile-role{font-size:10px;color:var(--muted);margin-top:4px}
.menu-btn{display:none}
.content{max-width:1600px;margin:auto;padding:29px 32px 35px}
.page{display:none;animation:appear .2s ease}
.page.active{display:block}
@keyframes appear{from{opacity:.55;transform:translateY(4px)}to{opacity:1;transform:none}}
.welcome{background:linear-gradient(115deg,#123c2b,#1d6443 68%,#26774c);border-radius:20px;padding:26px 28px;color:white;display:flex;align-items:center;justify-content:space-between;gap:18px;position:relative;overflow:hidden;margin-bottom:21px}
.welcome:after{content:"";position:absolute;right:100px;top:-110px;width:260px;height:260px;border:1px solid #ffffff15;border-radius:50%;box-shadow:0 0 0 35px #ffffff07,0 0 0 70px #ffffff05;pointer-events:none}
.welcome-copy{position:relative;z-index:1}
.welcome-label{font-size:10px;letter-spacing:1.8px;color:#b5e6c5;font-weight:700;margin-bottom:10px}
.welcome h1{font:800 clamp(22px,2.3vw,30px) Manrope,sans-serif;letter-spacing:-1.1px;margin:0 0 8px}
.welcome p{font-size:12px;color:#d4e8d9;margin:0;line-height:1.6}
.welcome-side{position:relative;z-index:1;text-align:right;min-width:130px}
.date-label{font-size:10px;color:#c0dfca;margin-bottom:7px}
.date-value{font:700 14px Manrope,sans-serif}
.store-open{display:inline-flex;align-items:center;gap:7px;border:1px solid #ffffff32;background:#ffffff12;border-radius:9px;padding:9px 11px;font-size:10px;margin-top:13px}
.store-open span{width:6px;height:6px;border-radius:50%;background:#8fe2a8}
.section-heading{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:24px 0 14px}
.section-heading h2{font:800 15px Manrope,sans-serif;letter-spacing:-.3px;margin:0}
.section-heading p{font-size:11px;color:var(--muted);margin:5px 0 0}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.stat{background:white;border:1px solid var(--line);border-radius:15px;padding:18px;box-shadow:var(--shadow);min-width:0}
.stat-top{display:flex;align-items:center;justify-content:space-between;gap:8px}
.stat-label{font-size:11px;color:var(--muted);font-weight:600}
.stat-icon{width:37px;height:37px;border-radius:12px;display:grid;place-items:center;font-size:18px;flex-shrink:0}
.stat-value{font:800 28px Manrope,sans-serif;letter-spacing:-1px;margin:15px 0 6px}
.stat-foot{font-size:10px;color:var(--muted);line-height:1.5}
.stat-foot strong{color:var(--green)}
.layout-two{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(270px,.85fr);gap:17px;margin-top:17px}
.layout-equal{display:grid;grid-template-columns:1fr 1fr;gap:17px;margin-top:17px}
.panel{background:white;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);min-width:0;overflow:hidden}
.panel-head{padding:19px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line)}
.panel-title{font:800 13px Manrope,sans-serif;margin:0}
.panel-sub{font-size:10px;color:var(--muted);margin-top:5px}
.link-btn{border:0;background:transparent;color:var(--green);font-size:11px;font-weight:800;padding:7px}
.link-btn:hover{text-decoration:underline}
.pipeline{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;padding:17px 20px;border-bottom:1px solid var(--line)}
.pipeline-step{background:#f7f9f6;border-radius:10px;padding:11px 9px;min-width:0}
.pipeline-step span{display:block;font-size:10px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pipeline-step strong{display:block;font:800 20px Manrope,sans-serif;margin-top:5px}
.pipeline-step.active-step{background:var(--mint)}
.pipeline-step.active-step span{color:var(--green)}
.order-list{padding:0 20px}
.order-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 0;border-bottom:1px solid #edf1ed}
.order-row:last-child{border-bottom:0}
.order-main{min-width:0}
.order-id{font-size:11px;font-weight:800}
.order-customer{font-size:11px;color:var(--muted);margin-top:5px}
.order-meta{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:8px}
.order-right{text-align:right;flex-shrink:0}
.order-total{font-size:12px;font-weight:800}
.order-actions{display:flex;justify-content:flex-end;gap:5px;margin-top:8px}
.badge{display:inline-flex;align-items:center;gap:5px;border-radius:7px;padding:6px 8px;font-size:9px;font-weight:800;white-space:nowrap;background:#f0f3f0;color:#66746a}
.badge:before{content:"";width:5px;height:5px;background:currentColor;border-radius:50%}
.badge.pending{color:var(--orange);background:var(--orangebg)}
.badge.preparing{color:var(--blue);background:var(--bluebg)}
.badge.packed{color:var(--purple);background:var(--purplebg)}
.badge.ready{color:var(--green);background:var(--mint)}
.badge.delivered{color:#5d7162;background:#edf2ed}
.badge.cancelled{color:var(--red);background:var(--redbg)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:9px 12px;border:1px solid var(--line);background:white;border-radius:9px;font-size:10px;font-weight:800;color:#536157;transition:.15s}
.btn:hover{border-color:#9cc6a8;color:var(--green)}
.btn-primary{background:var(--green);color:white;border-color:var(--green)}
.btn-primary:hover{background:var(--forest);color:white;border-color:var(--forest)}
.btn-danger{color:var(--red)}
.btn-small{padding:6px 8px;font-size:9px}
.activity-list{padding:3px 19px 9px}
.activity{display:flex;align-items:flex-start;gap:10px;padding:13px 0;border-bottom:1px solid #eff2ef}
.activity:last-child{border-bottom:0}
.activity-icon{height:32px;width:32px;border-radius:10px;display:grid;place-items:center;flex-shrink:0;font-size:15px}
.activity-copy{font-size:11px;line-height:1.6}
.activity-copy strong{font-weight:800}
.activity-time{font-size:9px;color:#98a199;margin-top:4px}
.stock-list{padding:0 19px 9px}
.stock-row{display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid #eff2ef}
.stock-row:last-child{border-bottom:0}
.product-icon{height:39px;width:39px;border-radius:11px;background:#f1f6f0;display:grid;place-items:center;font-size:21px;flex-shrink:0}
.stock-info{flex:1;min-width:0}
.stock-name{font-size:11px;font-weight:800}
.stock-cat{font-size:9px;color:var(--muted);margin-top:4px}
.stock-qty{text-align:right;font-size:11px;font-weight:800}
.stock-qty.low{color:var(--red)}
.stock-meter{height:4px;border-radius:5px;background:#edf1ed;overflow:hidden;margin-top:6px}
.stock-meter span{display:block;height:100%;background:#50a66b}
.stock-meter span.low{background:#e07d67}
.task-list{padding:4px 19px 9px}
.task-item{display:flex;align-items:flex-start;gap:10px;padding:12px 0;border-bottom:1px solid #eff2ef}
.task-item:last-child{border:0}
.task-item input{accent-color:var(--green);width:15px;height:15px;margin-top:2px}
.task-copy{flex:1;font-size:11px;line-height:1.5}
.task-copy.done{text-decoration:line-through;color:#98a199}
.task-meta{font-size:9px;color:var(--muted);margin-top:4px}
.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:17px}
.quick{border:1px solid var(--line);background:#fff;border-radius:12px;padding:14px;text-align:left;transition:.18s}
.quick:hover{border-color:#9ac7a7;background:#f7fbf7;transform:translateY(-2px)}
.quick-icon{font-size:21px;margin-bottom:10px}
.quick-title{font-size:11px;font-weight:800}
.quick-sub{font-size:9px;color:var(--muted);line-height:1.5;margin-top:5px}
.page-intro{display:flex;align-items:flex-end;justify-content:space-between;gap:15px;margin-bottom:20px}
.eyebrow{font-size:10px;font-weight:800;letter-spacing:1.6px;color:var(--green);margin-bottom:8px}
.page-intro h1{font:800 27px Manrope,sans-serif;letter-spacing:-1px;margin:0 0 7px}
.page-intro p{font-size:11px;color:var(--muted);margin:0;line-height:1.6}
.mini-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:17px}
.mini-stat{background:white;border:1px solid var(--line);border-radius:13px;padding:15px 17px}
.mini-stat span{font-size:10px;color:var(--muted)}
.mini-stat strong{display:block;font:800 22px Manrope,sans-serif;margin-top:6px}
.toolbar{display:flex;align-items:center;gap:9px;padding:15px 17px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.field{border:1px solid var(--line);background:white;border-radius:9px;padding:10px 11px;font-size:11px;color:#435247;min-width:0}
.field:focus{border-color:#87bb98;outline:none}
.toolbar .search-field{flex:1;min-width:160px}
.table-wrap{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:720px;text-align:left}
th{padding:13px 16px;background:#f9fbf8;color:#8a958c;font-size:9px;text-transform:uppercase;letter-spacing:1px;font-weight:800;white-space:nowrap}
td{padding:14px 16px;border-top:1px solid #eef2ee;font-size:11px;vertical-align:middle}
tbody tr:hover{background:#fbfdfb}
.t-strong{font-weight:800}
.t-muted{font-size:9px;color:var(--muted);margin-top:4px}
.table-actions{display:flex;gap:5px;flex-wrap:wrap;align-items:center}
.inventory-qty{display:flex;align-items:center;gap:7px}
.qty-btn{width:26px;height:26px;border:1px solid var(--line);background:white;border-radius:7px;font-weight:800}
.qty-btn:hover{background:var(--mint);color:var(--green)}
.qty-number{min-width:17px;text-align:center;font-weight:800}
.empty{text-align:center;padding:40px 18px;color:var(--muted);font-size:11px;line-height:1.7}
.empty-icon{font-size:30px;margin-bottom:8px}
.empty strong{display:block;color:var(--ink);font-size:12px;margin-bottom:4px}
.task-columns{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.task-row{display:flex;align-items:flex-start;gap:11px;padding:15px 18px;border-bottom:1px solid #eef2ee}
.task-row:last-child{border-bottom:0}
.task-check{width:16px;height:16px;accent-color:var(--green);margin-top:2px;flex-shrink:0}
.task-main{flex:1;min-width:0}
.task-main strong{display:block;font-size:11px}
.task-main p{font-size:10px;line-height:1.5;color:var(--muted);margin:5px 0 8px}
.task-row.completed .task-main strong{text-decoration:line-through;color:#98a199}
.team-row{display:flex;align-items:center;gap:12px;padding:17px 20px;border-bottom:1px solid #eef2ee}
.team-row:last-child{border-bottom:0}
.team-avatar{width:42px;height:42px;border-radius:13px;background:#e6f3e9;color:var(--green);display:grid;place-items:center;font-weight:800;flex-shrink:0}
.team-info{flex:1;min-width:0}
.team-info strong{font-size:11px}
.team-info p{font-size:10px;color:var(--muted);margin:5px 0 0}
.team-role{text-align:right;font-size:10px;color:var(--muted)}
.team-role strong{display:block;color:var(--green);margin-bottom:4px}
.report-bars{padding:20px}
.report-row{margin-bottom:20px}
.report-row:last-child{margin-bottom:0}
.report-label{display:flex;justify-content:space-between;gap:10px;font-size:11px;margin-bottom:8px}
.report-label span:last-child{color:var(--muted)}
.bar-track{height:8px;border-radius:8px;background:#edf1ed;overflow:hidden}
.bar-fill{height:100%;border-radius:8px}
.notice{border:1px solid #e8e9d5;background:#fffdf0;border-radius:12px;padding:14px 16px;color:#766a38;font-size:10px;line-height:1.7;margin-top:16px}
.footer{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:#98a198;font-size:9px;padding-top:25px}
.footer strong{color:var(--green)}
.modal-backdrop{display:none;position:fixed;inset:0;background:#0b2117a6;z-index:100;align-items:center;justify-content:center;padding:18px}
.modal-backdrop.open{display:flex}
.modal{width:min(510px,100%);max-height:90vh;overflow:auto;border-radius:18px;background:white;box-shadow:0 25px 90px #0003}
.modal-head{display:flex;align-items:center;justify-content:space-between;padding:19px 21px;border-bottom:1px solid var(--line)}
.modal-head h2{font:800 15px Manrope,sans-serif;margin:0}
.modal-close{border:0;background:#f1f4f0;border-radius:9px;width:31px;height:31px;font-size:19px}
.modal-body{padding:21px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}
.form-field{display:flex;flex-direction:column;gap:7px}
.form-field.full{grid-column:1/-1}
.form-field label{font-size:10px;font-weight:800;color:#526056}
.form-field input,.form-field select,.form-field textarea{border:1px solid var(--line);border-radius:9px;padding:11px;width:100%;background:white;font-size:11px}
.modal-foot{display:flex;justify-content:flex-end;gap:8px;padding:15px 21px;border-top:1px solid var(--line)}
.toast{position:fixed;bottom:24px;right:24px;z-index:150;max-width:calc(100vw - 40px);background:var(--forest);color:white;border-radius:11px;padding:13px 16px;font-size:11px;font-weight:700;box-shadow:0 10px 30px #0002;opacity:0;transform:translateY(12px);pointer-events:none;transition:.2s}
.toast.show{opacity:1;transform:translateY(0)}
.mobile-nav{display:none}
@media(max-width:1200px){
 .sidebar{width:225px}.main{margin-left:225px}.content{padding:24px}
 .topbar{padding:0 24px}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}
 .layout-two,.layout-equal{grid-template-columns:1fr}
}
@media(max-width:760px){
 .sidebar{transform:translateX(-100%);width:255px}.sidebar.open{transform:translateX(0);box-shadow:15px 0 40px #0003}
 .main{margin-left:0;padding-bottom:67px}
 .topbar{height:66px;padding:0 13px;gap:8px}
 .menu-btn{display:grid;flex-shrink:0}
 .top-title{font-size:14px}
 .breadcrumb{display:none}
 .search input{width:37px;height:37px;padding:0;color:transparent;cursor:pointer}
 .search input:focus{position:absolute;right:0;top:0;width:min(245px,66vw);padding:10px 10px 10px 33px;color:var(--ink);z-index:4;background:white}
 .search-icon{top:9px;pointer-events:none}
 .top-right{gap:6px}
 .profile{padding-left:6px;border:0}.profile-copy{display:none}.avatar{width:34px;height:34px}
 .content{padding:18px 13px 25px}
 .welcome{padding:21px 18px;align-items:flex-start}.welcome-side{min-width:auto}.date-label{font-size:9px}.date-value{font-size:11px}.store-open{font-size:9px;padding:8px}
 .welcome p{max-width:270px;font-size:11px}
 .stats{gap:9px}.stat{padding:14px}.stat-value{font-size:25px;margin:12px 0 5px}.stat-icon{width:32px;height:32px;font-size:16px}
 .stat-label{font-size:10px}.stat-foot{font-size:9px}
 .section-heading{margin-top:21px}
 .pipeline{padding:12px;gap:6px}.pipeline-step{padding:9px 7px}.pipeline-step span{font-size:8px}.pipeline-step strong{font-size:18px}
 .panel-head{padding:16px}
 .order-list,.stock-list,.activity-list,.task-list{padding-left:14px;padding-right:14px}
 .order-row{gap:7px}.order-id,.order-customer{font-size:10px}.order-total{font-size:11px}
 .page-intro{align-items:flex-start;flex-direction:column}.page-intro h1{font-size:24px}
 .mini-stats{gap:8px}.mini-stat{padding:12px}.mini-stat span{font-size:9px}.mini-stat strong{font-size:19px}
 .task-columns{grid-template-columns:1fr}
 .mobile-nav{position:fixed;left:0;right:0;bottom:0;height:62px;display:flex;align-items:center;justify-content:space-around;background:#fff;border-top:1px solid var(--line);z-index:40;padding-bottom:env(safe-area-inset-bottom)}
 .mobile-nav button{border:0;background:transparent;display:flex;flex-direction:column;align-items:center;gap:4px;color:#839087;font-size:9px;font-weight:800;padding:6px}
 .mobile-nav button span{font-size:18px}.mobile-nav button.active{color:var(--green)}
 .footer{padding-top:20px}
}
@media(max-width:400px){
 .welcome-side{display:none}.welcome h1{font-size:22px}
 .stats{grid-template-columns:1fr 1fr}
 .form-grid{grid-template-columns:1fr}.form-field.full{grid-column:auto}
 .toolbar{padding:12px}.toolbar .field{max-width:100%}
}
</style>
</head>
<body>
<aside class="sidebar" id="sidebar">
  <div class="brand">
    <div class="brand-icon">🌿</div>
    <div><div class="brand-title">GREEN MART <span style="color:#a8e4b7">V4</span></div><div class="brand-sub">OPERATIONS CENTRE</div></div>
  </div>
  <div class="nav-caption">WORKSPACE</div>
